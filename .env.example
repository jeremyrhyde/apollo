# Apollo environment overrides. Copy to `.env` (gitignored) and edit.
# Read by the server (config.py), the background service (it runs from the
# repo root, so .env is found), and the kiosk launcher (deploy/kiosk/start-kiosk.sh).

# --- Server (FastAPI) — all optional, defaults shown ----------------------
#HOST=0.0.0.0
#PORT=8001
#LOG_LEVEL=info
#WEB_DIR=./frontend/dist
#CONFIG_DIR=./config
#DB_PATH=./apollo.db

# --- Kiosk: which server the fullscreen Chromium points at ----------------
# Default is this machine (http://localhost:$PORT/). Set an IP to point a
# display at a server elsewhere on the network.
#SERVER_IP_ADDRESS=192.168.1.50
# Full URL override (wins over SERVER_IP_ADDRESS).
#APOLLO_UI_URL=http://192.168.1.50:8001/
